<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
    <urlCompression doDynamicCompression="false" />
        <rewrite>
            <rules>
                <rule name="ReverseProxyToNode" stopProcessing="true">
                    <match url="(.*)" />
                    <action type="Rewrite" url="http://127.0.0.1:4500/{R:1}" />
                </rule>
            </rules>
        </rewrite>
    </system.webServer>
</configuration>